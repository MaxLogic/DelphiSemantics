<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{9449E72C-B394-471A-BF20-50C7AAD60E34}</ProjectGuid>
    <ProjectVersion>20.3</ProjectVersion>
    <MainSource>LocalReceiver.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <AppType>Console</AppType>
    <DCC_ExeOutput>.dak\LocalReceiver\bin\$(Platform)</DCC_ExeOutput>
    <DCC_DcuOutput>.dak\LocalReceiver\dcu\$(Platform)</DCC_DcuOutput>
    <DCC_Namespace>System;$(DCC_Namespace)</DCC_Namespace>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <DCCReference Include="LocalConsumer.pas"/>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets"/>
</Project>
