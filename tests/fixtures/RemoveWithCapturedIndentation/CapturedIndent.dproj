<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{35D85F4E-243D-4D99-8FB3-4D1510FE7BEF}</ProjectGuid>
    <ProjectVersion>20.3</ProjectVersion>
    <MainSource>CapturedIndent.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <AppType>Console</AppType>
    <DCC_ExeOutput>.dak\CapturedIndent\bin\$(Platform)</DCC_ExeOutput>
    <DCC_DcuOutput>.dak\CapturedIndent\dcu\$(Platform)</DCC_DcuOutput>
