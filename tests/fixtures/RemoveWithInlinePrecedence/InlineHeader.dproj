<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{F1EC5965-0791-4669-A2F2-3D4E342944D6}</ProjectGuid>
    <ProjectVersion>20.3</ProjectVersion>
    <MainSource>InlineHeader.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <AppType>Console</AppType>
    <DCC_ExeOutput>.dak\InlineHeader\bin\$(Platform)</DCC_ExeOutput>
    <DCC_DcuOutput>.dak\InlineHeader\dcu\$(Platform)</DCC_DcuOutput>
