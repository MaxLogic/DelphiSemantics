<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{C4777739-C6A7-47AF-8D4A-0C7D541CC69F}</ProjectGuid>
    <MainSource>MsBuildProject.dpr</MainSource>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <ProjectName>MsBuildProject</ProjectName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <CfgDependentOn>Base.optset</CfgDependentOn>
    <DCC_Define>PROJECT_DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_IncludePath>Includes;$(PROJECTDIR)SharedIncludes;$(DCC_IncludePath)</DCC_IncludePath>
    <DCC_UnitSearchPath>Source;$(PROJECTDIR)Generated;$(MissingMacro)\Broken;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_UnitScopeNames>Project.Scope;$(DCC_UnitScopeNames)</DCC_UnitScopeNames>
    <DCC_Namespace>Namespace.Scope;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitAlias>Project.Legacy=Project.Modern;$(DCC_UnitAlias)</DCC_UnitAlias>
    <DCC_UnitAliases>Project.PluralLegacy=Project.PluralModern;$(DCC_UnitAliases)</DCC_UnitAliases>
  </PropertyGroup>
  <PropertyGroup Condition="'Debug'=='Debug'">
    <DCC_Define>LITERAL_COMPARISON_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'Debug'=='Debug'or'Release'=='Debug'">
    <DCC_Define>COMPACT_OR_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'Debug' != 'Release'">
    <DCC_Define>NOT_EQUAL_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'Debug'=='Debug' and Exists('Imported.props')">
    <DCC_Define>EXISTS_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'Debug'=='Debug' and !Exists('Missing.props')">
    <DCC_Define>NOT_EXISTS_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'bin'!='' and !HasTrailingSlash('bin')">
    <DCC_Define>NOT_TRAILING_SLASH_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'bin\'!='' and HasTrailingSlash('bin\')">
    <DCC_Define>TRAILING_SLASH_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'C:\Build Output'!='' and !HasTrailingSlash(C:\Build Output)">
    <DCC_Define>UNQUOTED_HAS_TRAILING_SLASH_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'Debug'=='Release' or ('No'=='Yes' or 'Debug'=='Debug')">
    <DCC_Define>PARENTHESIZED_OR_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup>
    <EnableImportedProps>true</EnableImportedProps>
    <LANGDIR>''</LANGDIR>
    <PreBuildEvent>echo before$(PreBuildEvent)</PreBuildEvent>
  </PropertyGroup>
  <Import Project="Imported.props" Condition="'$(EnableImportedProps)'=='true' And Exists('Imported.props')"/>
  <PropertyGroup Condition="'$(ImportedOrderFlag)'=='true'">
    <DCC_Define>IMPORT_ORDER_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup>
    <ImportedOverride>project</ImportedOverride>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ImportedOverride)'=='project'">
    <DCC_Define>POST_IMPORT_OVERRIDE_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LANGDIR)' != ''">
    <DCC_Define>LANGDIR_SHOULD_NOT_APPLY;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true')">
    <DCC_Define>INACTIVE_AND_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Config)'=='Debug')">
    <DCC_Define>ACTIVE_AND_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="('$(Config)'=='Debug') and ('$(Platform)'=='Win32')">
    <DCC_Define>ACTIVE_SPLIT_PAREN_DEFINE;$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release'">
    <DCC_Define>PROJECT_RELEASE</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ExternalDefine)'!=''">
    <DCC_Define>$(ExternalDefine);$(DCC_Define)</DCC_Define>
  </PropertyGroup>
  <ItemGroup>
    <DCCReference Include="Source\MainUnit.pas"/>
    <DCCReference Include="..\Shared\SharedUnit.pas"/>
    <DCCReference Include="Inactive\InactiveUnit.pas" Condition="'$(Config)'=='Release'"/>
    <DCCReference Include="$(MissingReferenceDir)\MacroUnit.pas"/>
  </ItemGroup>
  <ItemGroup Condition="'$(Config)'=='Release'">
    <DCCReference Include="InactiveGroup\InactiveGroupUnit.pas"/>
  </ItemGroup>
</Project>
