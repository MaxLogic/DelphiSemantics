<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MainSource>InvalidConditionProject.dpr</MainSource>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
  </PropertyGroup>
  <PropertyGroup Condition="'Debug'=='Debug' trailing">
    <DCC_Define>TRAILING_UNKNOWN</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'Debug'=='Debug' =">
    <DCC_Define>TRAILING_OPERATOR</DCC_Define>
  </PropertyGroup>
  <PropertyGroup Condition="'Debug'=='Debug">
    <DCC_Define>UNTERMINATED</DCC_Define>
  </PropertyGroup>
</Project>
