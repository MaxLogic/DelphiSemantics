<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{0264383F-077E-49FA-9F84-643ADF6EDFFB}</ProjectGuid>
    <ProjectVersion>20.3</ProjectVersion>
    <MainSource>NestedForwardCapture.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <AppType>Console</AppType>
    <DCC_ExeOutput>.dak\NestedForwardCapture\bin\$(Platform)</DCC_ExeOutput>
    <DCC_DcuOutput>.dak\NestedForwardCapture\dcu\$(Platform)</DCC_DcuOutput>
    <DCC_Namespace>System;$(DCC_Namespace)</DCC_Namespace>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <DCCReference Include="NestedForwardCaptureUnit.pas"/>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets"/>
</Project>
