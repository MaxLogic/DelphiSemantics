<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{4B150EFB-F869-44B9-8842-32829F62D79B}</ProjectGuid>
    <ProjectVersion>20.3</ProjectVersion>
    <MainSource>UnimportedProcedure.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <AppType>Console</AppType>
    <DCC_ExeOutput>.dak\UnimportedProcedure\bin\$(Platform)</DCC_ExeOutput>
    <DCC_DcuOutput>.dak\UnimportedProcedure\dcu\$(Platform)</DCC_DcuOutput>
    <DCC_Namespace>System;Winapi;$(DCC_Namespace)</DCC_Namespace>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <DCCReference Include="UnimportedProcedureConsumer.pas"/>
    <DCCReference Include="UnimportedProcedureProvider.pas"/>
    <DCCReference Include="PrivateProcedureConsumer.pas"/>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets"/>
</Project>
