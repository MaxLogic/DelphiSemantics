<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{5D6D770A-3688-4F66-9D6A-D5B1734FE85A}</ProjectGuid>
    <MainSource>UnitResolverProject.dpr</MainSource>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <ProjectName>UnitResolverProject</ProjectName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug'">
    <DCC_UnitSearchPath>Alias;Scoped;First;Second;Rtl;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>Winapi;Scoped;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitAlias>LegacyAlias=AliasTarget;$(DCC_UnitAlias)</DCC_UnitAlias>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="Alias\AliasTarget.pas"/>
    <DCCReference Include="Scoped\Scoped.TargetUnit.pas"/>
    <DCCReference Include="First\DuplicateUnit.pas"/>
    <DCCReference Include="Rtl\Winapi.Windows.pas"/>
  </ItemGroup>
  <ItemGroup>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
      <CfgParent/>
    </BuildConfiguration>
    <BuildConfiguration Include="Release">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Debug">
      <Key>Cfg_2</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType/>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">UnitResolverProject.dpr</Source>
        </Source>
      </Delphi.Personality>
      <Platforms>
        <Platform value="Win32">True</Platform>
        <Platform value="Win64">False</Platform>
      </Platforms>
    </BorlandProject>
    <ProjectFileVersion>12</ProjectFileVersion>
  </ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
  <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
