<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
<PropertyGroup><MainSource>P.dpr</MainSource><ProjectVersion>20.1</ProjectVersion><FrameworkType>None</FrameworkType>
<Base>True</Base><Config>Debug</Config><Platform>Win64</Platform><TargetedPlatforms>2</TargetedPlatforms><AppType>Console</AppType>
<DCC_Namespace>System;Winapi</DCC_Namespace><DCC_UnitSearchPath>.</DCC_UnitSearchPath><DCC_ExeOutput>out</DCC_ExeOutput><DCC_DcuOutput>dcu</DCC_DcuOutput></PropertyGroup>
