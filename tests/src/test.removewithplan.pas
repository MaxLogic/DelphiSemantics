  lPlan: TDelphiSemanticRemoveWithPlan;
  lStatement: TDelphiSemanticRemoveWithFinalStatement;
begin
  lPlan := BuildPlanForProject(DakFixturePath(
    'RemoveWithPlannerFixture\RemoveWithPlannerFixture.dproj'));

