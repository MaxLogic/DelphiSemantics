        Inc(lInterfaceCount);
    end;
  Assert.IsTrue(lMatches > 0, 'The source declaration must be indexed.');
  Assert.AreEqual(cInterfaceCounts[aCase], lInterfaceCount);
  lPlan := TDelphiSemanticRemoveWithCompatibilityApi.PlanRemoveWith(lFacts);
