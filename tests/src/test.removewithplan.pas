  Assert.AreEqual('29f244ab68fb92522262b36bb725dc627d9a7142071d7f4a0e1207c75659b118', lStatement.Verification.ExpectedFileHash);
  Assert.AreEqual('with RelRec, w[0] do' + #13#10 +
    '  begin' + #13#10 +
    '    aktiv := True;' + #13#10 +
    '    n := 0;' + #13#10 +
    '    lf := d;' + #13#10 +
