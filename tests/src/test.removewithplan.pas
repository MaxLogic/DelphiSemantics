  Assert.AreEqual('WITH fptr^ DO' + #10 +
    '  BEGIN' + #10 +
    '    last^.next := next;' + #10 +
    '    next^.last := last;' + #10 +
    '    IF FileQueue = fptr THEN' + #10 +
