    '  lWithEasyVarPtr: ^EasyVar;' + #13#10 +
    '  lWithArrayVarRecPtr: ^ArrayVarRec;' + #13#10 +
    '  lWithArrayRecPtr: ^ArrayRec;' + #13#10,
    '  lWithEasyVarPtr := @VarList[n];' + #13#10 +
    '  begin' + #13#10 +
    '    if TestFlags(lWithEasyVarPtr^.tFlags, TArray) then' + #13#10 +
